	try{
		if(jQuery(window).width() >= 1279){
			var winT = jQuery(window).scrollTop() + jQuery('.main_sec03 .top').height() + 50;
	
			var conT = jQuery('.main_sec03 .tab_content .flex_area .fix_photo').offset().top;
